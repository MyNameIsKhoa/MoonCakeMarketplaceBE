# Copy to .env and replace every secret with an independent random value.
# .env is ignored by Git and excluded from Docker build contexts.
MSSQL_SA_PASSWORD=replace-with-a-strong-random-password
MSSQL_MEMORY_LIMIT_MB=1024
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ISSUER=mooncake-identity
JWT_AUDIENCE=mooncake-api
CATALOG_TO_IDENTITY_TOKEN=replace-with-an-independent-random-secret
COMMERCE_TO_IDENTITY_TOKEN=replace-with-an-independent-random-secret
RFQ_TO_IDENTITY_TOKEN=replace-with-an-independent-random-secret
COMMERCE_TO_CATALOG_TOKEN=replace-with-an-independent-random-secret
RFQ_TO_CATALOG_TOKEN=replace-with-an-independent-random-secret
RFQ_TO_COMMERCE_TOKEN=replace-with-an-independent-random-secret
ADMIN_USER_IDS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
APP_FRONTEND_URL=http://localhost:3000
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=30
GOOGLE_CLIENT_IDS=

# Configure SMTP before enabling email registration and password reset.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Only for an existing Identity database whose V1 schema is already present without Flyway history.
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1

# payOS / finance (TV5).
# Secrets only belong in backend .env (gitignored), never VITE_* or frontend.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/?finance=return
PAYOS_CANCEL_URL=http://localhost:3000/?finance=cancel

# Fee is 5% of collected money after confirmed refunds; round to a whole VND.
FINANCE_FEE_BASIS=NET_AFTER_REFUND
FINANCE_FEE_ROUNDING=HALF_UP
# ADMIN decides escalated disputes; disable only when operating without an adjudicator.
FINANCE_DISPUTE_ADMIN_ENABLED=true

# Catalog image uploads (local: leave directory blank to use the application default).
# CATALOG_UPLOAD_DIR=D:/MooncakeUploads/catalog
CATALOG_PUBLIC_BASE_URL=http://localhost:8080
