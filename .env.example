# Merge with the authentication/database environment described in README.md.
# Secrets only belong in backend .env (gitignored), never VITE_* or frontend.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/?finance=return
PAYOS_CANCEL_URL=http://localhost:5173/?finance=cancel

# Leave blank until the team approves the fee basis and rounding rule.
# Supported explicit choices: TOTAL_COLLECTED and HALF_UP / DOWN / UP.
FINANCE_FEE_BASIS=
FINANCE_FEE_ROUNDING=
# Enable only after ADMIN has been approved as the dispute adjudicator.
FINANCE_DISPUTE_ADMIN_ENABLED=false
